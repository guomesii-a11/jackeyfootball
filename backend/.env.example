# ============================================================
# JackeyFootball 环境变量示例
# 复制本文件为 .env 并按需修改（.env 已被 .gitignore 忽略）
# ============================================================

# 数据库（默认 SQLite，一般无需修改）
DATABASE_URL=sqlite:///./jackeyfootball.db

# ------------------------------------------------------------
# TheSportsDB 免费数据源
# ------------------------------------------------------------
# 免费层默认测试 Key 为 "3"，无需注册即可拉取真实球员资料（头像/俱乐部/国籍等）。
# 该默认值已内置在 config.py 中，因此不填也能直接运行 import_real_data.py。
#
# 如需更高请求额度或更完整数据：
#   1. 打开 https://www.thesportsdb.com 注册账号
#   2. 通过 Patreon 订阅（免费档或付费档均可获得个人 API Key）
#   3. 将下方值替换为你的个人 Key
THESPORTSDB_API_KEY=3

# ------------------------------------------------------------
# football-data.org（可选，当前未使用）
# ------------------------------------------------------------
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
